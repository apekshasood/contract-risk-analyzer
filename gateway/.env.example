# Copy to .env. Never commit .env.
PORT=3001
AI_ENGINE_URL=http://localhost:8000
# Comma-separated origins allowed to call the gateway
CORS_ORIGIN=http://localhost:3000

# Supabase: Project Settings > API. The service_role key is a secret (server only!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret between gateway and engine. Same value in legal-auditor-ai/.env.
# Make one with: openssl rand -hex 32
ENGINE_SECRET=change-me

# Audits per user per 24 hours
DAILY_AUDIT_LIMIT=5
